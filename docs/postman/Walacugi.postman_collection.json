{
  "info": {
    "name": "Walacugi API",
    "_postman_id": "4c5970fd-8717-4234-a112-d42ea7e59239",
    "description": "Admin auth + equipment rental routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login (set token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('adminToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            }
          }
        },
        {
          "name": "Verify token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{adminToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/verify-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "verify-token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "List models",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment"
              ]
            }
          }
        },
        {
          "name": "Create model (auto Unit #1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Kayak\",\n  \"title\": \"River Kayak\",\n  \"description\": \"Stable touring kayak\",\n  \"pricePerDay\": 25,\n  \"currency\": \"EUR\",\n  \"size\": \"M\",\n  \"images\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment"
              ]
            }
          }
        },
        {
          "name": "Get model + units",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/equipment/{{modelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{modelId}}"
              ]
            }
          }
        },
        {
          "name": "Update model",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"River Kayak Plus\",\n  \"pricePerDay\": 30,\n  \"updatedAt\": \"{{isoNow}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/equipment/{{modelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{modelId}}"
              ]
            }
          }
        },
        {
          "name": "Delete model",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{modelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{modelId}}"
              ]
            }
          }
        },
        {
          "name": "Clone unit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/units/{{unitId}}/clone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "units",
                "{{unitId}}",
                "clone"
              ]
            }
          }
        },
        {
          "name": "Update unit (condition/status)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"condition\": \"good\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/equipment/units/{{unitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "units",
                "{{unitId}}"
              ]
            }
          }
        },
        {
          "name": "Delete unit",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/units/{{unitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "units",
                "{{unitId}}"
              ]
            }
          }
        },
        {
          "name": "Availability by range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/equipment/{{modelId}}/availability?startDate={{startDate}}&endDate={{endDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{modelId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "{{startDate}}"
                },
                {
                  "key": "endDate",
                  "value": "{{endDate}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create unit block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"reason\": \"Maintenance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/equipment/units/{{unitId}}/blocks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "units",
                "{{unitId}}",
                "blocks"
              ]
            }
          }
        },
        {
          "name": "Delete unit block",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/blocks/{{blockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "blocks",
                "{{blockId}}"
              ]
            }
          }
        },
        {
          "name": "Confirm booking (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkoutRef\": \"checkout-demo-001\",\n  \"items\": [\n    {\n      \"unitId\": \"{{unitId}}\",\n      \"startDate\": \"{{startDate}}\",\n      \"endDate\": \"{{endDate}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/equipment/confirm-booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "confirm-booking"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "List reservations",
          "request": {
